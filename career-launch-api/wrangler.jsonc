{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "career-launch-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-08",
	"d1_databases": [
		{
			"binding": "career_launch_db",
			"database_name": "career-launch-db",
			"database_id": "7c7d9e54-407d-47e6-99ae-3c3bbcb6f97f",
			"remote": true
		}
	],
	// "compatibility_flags": [
	//   "nodejs_compat"
	// ],
	"ratelimits": [
		{
			"name": "FORM_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	],
	"vars": {
		// wrangler.jsonc
		"PAYPAL_BASE": "https://api-m.paypal.com",
		"PAYPAL_PLAN_APPRENTICESHIP": "P-3U1548787M352200NNL6TR2Q",
		"PAYPAL_PLAN_MENTORSHIP_6MO": "P-5JN38967VM498133HNL6TR2Q",
		"PAYPAL_PLAN_MENTORSHIP_3MO": "P-0PK49607GC382161XNL6TR2Y",
		"PAYPAL_PLAN_APPRENTICESHIP_UPFRONT": "P-1U107490A7047903UNL7OE3A",
		"PAYPAL_PLAN_MENTORSHIP_6MO_UPFRONT": "P-8GL37147C13413200NL7OE3I",
		"PAYPAL_PLAN_MENTORSHIP_3MO_UPFRONT": "P-3SK044269P782835DNL7OE3I"
	},
